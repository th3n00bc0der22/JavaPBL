package models;

public abstract class Personagem {

    private final int id;
    private String nome;

    public Personagem(int id, String nome) {
        this.id = id;
        this.nome = nome;
    }

    public int getId() {
        return id;
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }
}


  
public class Psecundario extends Personagem {
 
    public Psecundario(int id, String nome) {
        super(id, nome);
    }
}


public class Pista {
 
    private String nome;
    private String descricao;
 
    public Pista(String nome, String descricao) {
        this.nome = nome;
        this.descricao = descricao;
    }
 
    public String getNome() {
        return nome;
    }
 
    public String getDescricao() {
        return descricao;
    }
}



public class Dialogo {
 
    private Personagem personagem;
    private String conteudo;
    private String tipo;
 
    public Dialogo(Personagem personagem, String conteudo, String tipo) {
        this.personagem = personagem;
        this.conteudo = conteudo;
        this.tipo = tipo;
    }
 
    public Personagem getPersonagem() {
        return personagem;
    }
 
    public String getConteudo() {
        return conteudo;
    }
 
    public String getTipo() {
        return tipo;
    }
}



