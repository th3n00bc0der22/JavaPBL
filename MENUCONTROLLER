package controllers;

import views.MenuView;

import java.util.List;

// Controla o fluxo do menu principal e direciona cada opção para a ação correspondente.
// Também valida as opções do menu e o temperamento antes de iniciar a partida.
public class MenuController {

    // Mantém o menu em execução até que o jogador escolha a opção de sair.
    public static Boolean menuPrincipalController() {

        int option = 0;


        // Repete o menu enquanto a opção de saída não for escolhida.
        while (option != 4) {

            option = MenuView.openMenu();


            // Valida se a opção escolhida pertence ao menu principal.
            while (!List.of(
                    1, 2, 3, 4
            ).contains(option)) {

                MenuView.apresentaErro(
                        "A entrada fornecida é inválida."
                );

                option =
                        MenuView.openMenu();
            }

            if (option == 1) {

                int atributoOption =
                        MenuView.openAtributesMenu();

                while (!List.of(
                        1, 2, 3
                ).contains(atributoOption)) {

                    MenuView.apresentaErro(
                            "A entrada fornecida é inválida."
                    );

                    atributoOption =
                            MenuView.openAtributesMenu();
                }

                // Cria o Controller da partida e envia o temperamento escolhido pelo jogador.
                JogoController jogoController =
                        new JogoController();

                jogoController.iniciarJogo(
                        atributoOption
                );
            }


      
            // Abre a tela de instruções e depois retorna ao menu.
            if (option == 2) {

                MenuView.Instrucoes();
            }

            // Exibe os créditos do projeto.
            if (option == 3) {

                MenuView.Creditos();
            }

            // Encerra o fluxo do menu quando o jogador seleciona a opção 4.
            if (option == 4) {

                return true;
            }
        }


        return false;
    }
}
